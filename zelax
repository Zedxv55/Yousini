#!/usr/bin/env bash
# Zelax launcher — พิมพ์ 'zelax' เพื่อเปิด Agent
# ไล่ตาม symlink หาตำแหน่งจริงของ repo (แบบเดียวกับ nvm/tools) ใช้เครื่องอื่นได้
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
AGENT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
cd "$AGENT_DIR" || exit 1
exec python3 "$AGENT_DIR/zelax.py" "$@"
