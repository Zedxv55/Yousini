# ============================================================
# Zelax config — คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า
# รองรับทุก OpenAI-compatible API (เลือก provider ได้อิสระ)
# ============================================================

# ---- 1) Groq (ฟรี, ค่าเริ่มต้นแนะนำ) ----
ZELAX_BASE_URL=https://api.groq.com/openai/v1
ZELAX_API_KEY=ใส่_groq_key
ZELAX_MODEL=openai/gpt-oss-120b

# ---- 2) ตัวอย่าง provider อื่น (เอา COMMENT ออกบรรทัดไหนที่จะใช้) ----
# OpenAI:
# ZELAX_BASE_URL=https://api.openai.com/v1
# ZELAX_API_KEY=sk-...
# ZELAX_MODEL=gpt-4o

# OpenRouter (เข้าถึงหลายโมเดล เช่น Claude/Gemini/Llama):
# ZELAX_BASE_URL=https://openrouter.ai/api/v1
# ZELAX_API_KEY=sk-or-...
# ZELAX_MODEL=anthropic/claude-3.5-sonnet

# DeepSeek:
# ZELAX_BASE_URL=https://api.deepseek.com/v1
# ZELAX_API_KEY=sk-...
# ZELAX_MODEL=deepseek-chat

# Mistral:
# ZELAX_BASE_URL=https://api.mistral.ai/v1
# ZELAX_API_KEY=...
# ZELAX_MODEL=mistral-large-latest

# ---- ความปลอดภัย ----
# AUTO_RUN=1  → รัน shell ทันทีโดยไม่ถาม (อันตราย แนะนำ 0)
AUTO_RUN=0
# CONFIRM_FILES=0 → เขียน/แก้ไฟล์ไม่ต้องถาม
CONFIRM_FILES=1
# ตัดคำสั่งที่ค้างเกินกี่วินาที
SHELL_TIMEOUT=60
