# ============================================================
# Yousini config — คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า
# รองรับทุก OpenAI-compatible API (เลือก provider ได้อิสระ)
# ============================================================

# ---- 1) Groq (ฟรี, ค่าเริ่มต้นแนะนำ) ----
YOUSINI_BASE_URL=https://api.groq.com/openai/v1
YOUSINI_API_KEY=ใส่_groq_key
YOUSINI_MODEL=openai/gpt-oss-120b

# ---- 2) ตัวอย่าง provider อื่น (เอา COMMENT ออกบรรทัดไหนที่จะใช้) ----
# OpenAI:
# YOUSINI_BASE_URL=https://api.openai.com/v1
# YOUSINI_API_KEY=sk-...
# YOUSINI_MODEL=gpt-4o

# OpenRouter (เข้าถึงหลายโมเดล เช่น Claude/Gemini/Llama):
# YOUSINI_BASE_URL=https://openrouter.ai/api/v1
# YOUSINI_API_KEY=sk-or-...
# YOUSINI_MODEL=anthropic/claude-3.5-sonnet
# --- โมเดลฟรีบน OpenRouter (แนะนำถ้าไม่มีคีย์เสียเงิน) ---
# YOUSINI_MODEL=cohere/north-mini-code:free

# --- Web search ผ่าน API จริง (ทางเลือกเสริม แทน scraping) ---
# YOUSINI_SEARCH_PROVIDER=brave
# YOUSINI_SEARCH_API_KEY=...(หรือใช้ BRAVE_API_KEY / SERPAPI_KEY / TAVILY_API_KEY)

# DeepSeek:
# YOUSINI_BASE_URL=https://api.deepseek.com/v1
# YOUSINI_API_KEY=sk-...
# YOUSINI_MODEL=deepseek-chat

# Mistral:
# YOUSINI_BASE_URL=https://api.mistral.ai/v1
# YOUSINI_API_KEY=...
# YOUSINI_MODEL=mistral-large-latest

# ---- ความปลอดภัย ----
# AUTO_RUN=1  → รัน shell ทันทีโดยไม่ถาม (อันตราย แนะนำ 0)
AUTO_RUN=0
# CONFIRM_FILES=0 → เขียน/แก้ไฟล์ไม่ต้องถาม
CONFIRM_FILES=1
# ตัดคำสั่งที่ค้างเกินกี่วินาที
SHELL_TIMEOUT=60

# ---- ฟีเจอร์ใหม่ (ทั้งหมดเปิดทำงานได้ ปิดด้วย 0 ถ้าไม่ต้องการ) ----
# ชื่อไฟล์บริบทโปรเจกต์ (เหมือน CLAUDE.md) — โหลดอัตโนมัติเมื่อเริ่มงาน
YOUSINI_CONTEXT=YOUSINI.md
# โฟลเดอร์สกิล (relative ต่อ cwd) — โหลด *.md เข้า system prompt
YOUSINI_SKILLS=skills
# โฟลเดอร์ hooks: ถ้าเว้นว่าง จะหา ./.yousini/hooks แล้ว ~/.yousini/hooks
# YOUSINI_HOOKS=./.yousini/hooks
# เปิด/ปิด auto-checkpoint (git commit ก่อนแก้ไฟล์ เพื่อ /rollback ได้)
YOUSINI_CHECKPOINT=1
# ที่เก็บ session (บันทึกบทสนทนาลงดิสก์)
# YOUSINI_SESSIONS=~/.yousini/sessions

# ============================================================
# Provider สำรอง (Phase 5) — เมื่อตัวหลักโค้ต้าหมด/ล่ม สลับอัตโนมัติ
# รูปแบบ JSON array: [{"base_url": "...", "api_key": "..."}, ...]
# ตัวอย่าง (Groq + DeepSeek + OpenRouter):
# YOUSINI_FALLBACK_PROVIDERS=[{"base_url":"https://api.groq.com/openai/v1","api_key":"gsk_..."},{"base_url":"https://api.deepseek.com/v1","api_key":"sk-..."}]
# ============================================================
