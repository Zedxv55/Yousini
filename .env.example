# === คัดลอกไฟล์นี้เป็น .env แล้วใส่ key ของคุณ ===
# รับ key ฟรีที่ https://console.groq.com/keys

GROQ_API_KEY=ใส่_api_key_ของคุณ
GROQ_BASE_URL=https://api.groq.com/openai/v1

# โมเดลเริ่มต้น (Groq แนะนำ openai/gpt-oss-120b — llama-3.3-70b ถูกประกาศเลิกใช้แล้ว)
# ตัวเลือกที่ใช้ได้บน Groq:
#   openai/gpt-oss-120b       (ค่าเริ่มต้น แนะนำ ทรงพลังมาก)
#   llama-3.3-70b-versatile   (เลิกใช้ 16 ส.ค. 2026 — อย่าใช้)
#   qwen/qwen3.6-27b          (ความสามารถสูง)
#   groq/compound             (โมเดล agentic ของ Groq)
GROQ_MODEL=openai/gpt-oss-120b

# === ความปลอดภัย ===
# AUTO_RUN=1  → รัน shell ทันทีโดยไม่ถาม (อันตราย แนะนำ 0)
AUTO_RUN=0
# CONFIRM_FILES=0 → เขียน/แก้ไฟล์ไม่ต้องถาม
CONFIRM_FILES=1
# ตัดคำสั่งที่ค้างเกินกี่วินาที
SHELL_TIMEOUT=60
